PROJECT_NAME="HomeCare 360 API"
API_V1_STR="/api/v1"
SECRET_KEY="homecare360-super-secret-jwt-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database: SQLite for local dev, PostgreSQL for production (Supabase/Neon)
DATABASE_URL="sqlite:///./homecare360.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"

# CORS origins (comma-separated or JSON list)
CORS_ORIGINS=["https://homecare360-pied.vercel.app","http://localhost:5173","http://localhost:3000","http://localhost:8443","http://127.0.0.1:5173","http://127.0.0.1:8443"]

ENVIRONMENT="development"
